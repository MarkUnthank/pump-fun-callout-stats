{
  "manifest_version": 3,
  "name": "Callout Stats for pump.fun",
  "version": "0.3.0",
  "description": "See any pump.fun caller's record on their callouts: calls, entry market cap and average multiple for 24h, 7d and 30d.",
  "homepage_url": "https://notrandom.fun",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://notrandom.fun/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Callout Stats", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{ "matches": ["https://pump.fun/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{
    "resources": ["app.js", "stats.js", "tone.js", "extension-client.js", "feed.js", "account.js", "cache.js", "panel.css", "card.css", "mascot.png", "fonts/fredoka.woff2"],
    "matches": ["https://pump.fun/*"]
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
